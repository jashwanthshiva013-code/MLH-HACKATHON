# GitHub API token (BACKEND ONLY — never exposed to the frontend).
# For public repositories no scopes are required.
# Raises the rate limit from 60 to 5,000 requests/hour.
GITHUB_TOKEN=

# AI provider: evidence (default, offline) | ollama | openai_compatible
AI_PROVIDER=evidence

# API key for an OpenAI-compatible endpoint (AI_API_KEY is an accepted alias
# for OPENAI_COMPAT_KEY). Never hardcode a real key here.
AI_API_KEY=
OPENAI_COMPAT_URL=
OPENAI_COMPAT_MODEL=

# Ollama — local open-weight models (e.g. llama3.1, qwen2.5)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
